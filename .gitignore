<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>منصة محمد مصطفى الأفندي | تعليم الإنجليزي أونلاين</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#f4faff;--surface:#ffffff;--ink:#0b2a42;--muted:#55708a;--line:#d6e8f6;--sky:#0ea5e9;--sky-d:#0369a1;--sky-l:#e0f2fe;--on-sky:#ffffff;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:light}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#050608;--surface:#0d1218;--ink:#f1f8ff;--muted:#8aa0b2;--line:#1a2733;--sky:#38bdf8;--sky-d:#7dd3fc;--sky-l:#0b2233;--on-sky:#031018;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#050608;--surface:#0d1218;--ink:#f1f8ff;--muted:#8aa0b2;--line:#1a2733;--sky:#38bdf8;--sky-d:#7dd3fc;--sky-l:#0b2233;--on-sky:#031018;color-scheme:dark}
*,*::before,*::after{box-sizing:border-box}
html{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 76px);scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Cairo,"Segoe UI",Tahoma,sans-serif;line-height:1.8;font-size:17px}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--surface);z-index:10}
h1,h2,h3{margin:0;line-height:1.4;font-weight:800}
a{color:inherit}
:focus-visible{outline:3px solid var(--sky);outline-offset:3px}
.wrap{max-width:1080px;margin:0 auto;padding:0 20px}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:9;background:var(--surface);border-bottom:1px solid var(--line)}
.bar{display:flex;align-items:center;gap:12px;height:66px}
.logo{display:flex;align-items:center;gap:10px;text-decoration:none;font-weight:800;font-size:19px;margin-inline-end:auto}
.mark{width:38px;height:38px;border-radius:11px;background:var(--sky);color:var(--on-sky);display:grid;place-items:center;font-size:20px}
nav{display:none;gap:20px}
nav a{text-decoration:none;color:var(--muted);font-weight:600}
nav a:hover{color:var(--sky-d)}
@media(min-width:820px){nav{display:flex}}
button{font:inherit;cursor:pointer}
.btn{border:0;border-radius:999px;padding:10px 24px;font-weight:800;background:var(--sky);color:var(--on-sky);text-decoration:none;display:inline-block}
.btn.ghost{background:var(--sky-l);color:var(--sky-d)}
.icon{width:40px;height:40px;border-radius:50%;background:var(--sky-l);border:0;color:var(--sky-d)}
.tag{display:inline-block;background:var(--sky-l);color:var(--sky-d);font-weight:700;font-size:14px;border-radius:999px;padding:2px 14px;margin-bottom:12px}
.hero{background:linear-gradient(180deg,var(--sky-l),var(--bg));padding:56px 0 44px}
.hero .wrap{display:grid;gap:34px;align-items:center}
@media(min-width:860px){.hero .wrap{grid-template-columns:1.1fr .9fr}.hero{padding:80px 0 64px}}
.hero h1{font-size:clamp(30px,6vw,50px)}
.hero p{color:var(--muted);margin:14px 0 24px;max-width:32em}
.cta{display:flex;flex-wrap:wrap;gap:12px}
.nums{display:flex;gap:28px;margin-top:30px}
.nums b{display:block;font-size:28px;color:var(--sky-d)}
.nums span{font-size:14px;color:var(--muted)}
.card-word{background:var(--surface);border:1px solid var(--line);border-radius:26px;padding:30px 24px;text-align:center;box-shadow:0 18px 40px -20px rgba(14,165,233,.45)}
.card-word small{color:var(--muted)}
.word{font-size:clamp(34px,7vw,46px);font-weight:800;direction:ltr;color:var(--sky-d);line-height:1.3;margin-top:6px}
.mean{font-size:22px;font-weight:700;min-height:40px}
.card-word button{margin-top:14px}
.reveal .word{animation:pop .5s ease-out}
@keyframes pop{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
section{padding:60px 0}
.head{text-align:center;max-width:560px;margin:0 auto 32px}
.head h2{font-size:clamp(24px,4.5vw,34px)}
.head p{color:var(--muted);margin:6px 0 0}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:22px}
.teacher{display:grid;gap:20px;padding:26px;max-width:640px;margin:auto;text-align:center;justify-items:center}
@media(min-width:620px){.teacher{grid-template-columns:auto 1fr;text-align:start;justify-items:start;align-items:center}}
.avatar{width:104px;height:104px;border-radius:50%;background:var(--sky);color:var(--on-sky);display:grid;place-items:center;font-size:44px;font-weight:800}
.teacher p{margin:2px 0 12px;color:var(--muted)}
.grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(250px,1fr))}
.item{padding:24px}
.item h3{font-size:19px;margin-bottom:4px}
.item p{margin:0 0 16px;color:var(--muted)}
.grade{padding:22px;text-align:center}
.grade h3{font-size:18px;margin:6px 0 14px}
.grade .cnt{display:inline-block;background:var(--sky-l);color:var(--sky-d);font-size:14px;font-weight:700;border-radius:999px;padding:0 12px}
.why{display:grid;gap:26px;align-items:center}
@media(min-width:820px){.why{grid-template-columns:1fr 1fr}}
.why ul{list-style:none;margin:0;padding:0;display:grid;gap:12px}
.why li{display:flex;gap:12px;align-items:center;padding:14px 16px;font-weight:600}
.why li::before{content:"✓";flex:none;width:28px;height:28px;border-radius:50%;background:var(--sky);color:var(--on-sky);display:grid;place-items:center;font-size:15px}
.join{padding:32px;text-align:center;background:var(--sky);color:var(--on-sky);border:0}
.join p{margin:8px 0 20px}
.join .btn{background:var(--surface);color:var(--sky-d)}
.apps{padding:30px;text-align:center}
footer{background:var(--surface);border-top:1px solid var(--line);padding:34px 0 26px;text-align:center}
footer .links,footer .soc{display:flex;flex-wrap:wrap;gap:10px 22px;justify-content:center;margin:14px 0}
footer .soc a{width:44px;height:44px;border-radius:50%;background:var(--sky-l);color:var(--sky-d);display:grid;place-items:center;font-weight:800;text-decoration:none;font-size:14px}
footer small{color:var(--muted)}
dialog{border:1px solid var(--line);border-radius:22px;padding:0;background:var(--surface);color:var(--ink);width:min(440px,92vw);max-height:90dvh;overflow:auto}
dialog::backdrop{background:rgba(3,25,45,.6)}
.dlg{padding:26px}
.tabs{display:flex;background:var(--sky-l);border-radius:999px;padding:4px;margin:16px 0 18px;gap:4px}
.tabs button{flex:1;border:0;background:transparent;color:var(--sky-d);padding:8px;border-radius:999px;font-weight:700}
.tabs button[aria-selected="true"]{background:var(--sky);color:var(--on-sky)}
label{display:block;font-weight:600;font-size:15px;margin:12px 0 4px}
input,select{width:100%;font:inherit;padding:11px 14px;border-radius:12px;border:1.5px solid var(--line);background:var(--bg);color:var(--ink)}
.pane{display:none}.pane.on{display:block}
.full{width:100%;margin-top:18px}
.msg{margin-top:12px;font-size:14px;color:var(--sky-d);min-height:22px}
.x{float:inline-end}
#app{display:none}.in-app #app{display:block}.in-app header,.in-app main,.in-app footer{display:none}
.ab{background:var(--surface);border-bottom:1px solid var(--line);position:sticky;top:env(safe-area-inset-top,0px);z-index:9}
.ab .wrap{display:flex;align-items:center;gap:10px;min-height:64px;padding-block:8px}
.who{margin-inline-end:auto;font-weight:800;line-height:1.5}.who small{display:block;color:var(--muted);font-weight:600;font-size:13px}
.tb{display:flex;gap:6px;overflow-x:auto;padding:16px 0 12px}
.tb button{border:0;border-radius:999px;padding:8px 18px;font-weight:700;background:var(--sky-l);color:var(--sky-d);white-space:nowrap}
.tb button[aria-selected="true"]{background:var(--sky);color:var(--on-sky)}
.row{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;padding:16px 18px;margin-bottom:12px}
.row h3{font-size:17px}.row small{color:var(--muted)}.row .acts{display:flex;gap:8px;align-items:center}.row input{width:140px}
.q{padding:18px;margin-bottom:12px}.q label{display:flex;gap:8px;align-items:center;font-weight:500;margin:6px 0}.q input{width:auto}
.tbl{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:15px}th,td{padding:9px 10px;border-bottom:1px solid var(--line);text-align:start;white-space:nowrap}
.empty{text-align:center;color:var(--muted);padding:44px 0}
textarea{width:100%;font:inherit;padding:11px 14px;border-radius:12px;border:1.5px solid var(--line);background:var(--bg);color:var(--ink);min-height:130px}
.form{padding:22px;max-width:620px}.res{padding:22px;text-align:center;font-weight:800;font-size:22px;color:var(--sky-d);margin-bottom:12px}
.st{min-height:24px;margin:10px 0;color:var(--sky-d);font-weight:600}.ok{color:#16a34a}.bad{color:#ef4444}
.hint{font-size:13px;color:var(--muted);margin:10px 0 0}
.btn,.icon,.tb button{transition:transform .2s,box-shadow .2s,background .2s}
.btn:hover{transform:translateY(-2px);box-shadow:0 10px 22px -10px var(--sky)}
.btn:active{transform:none}
.panel{transition:transform .25s,box-shadow .25s,border-color .25s}
.panel:hover{transform:translateY(-4px);border-color:var(--sky);box-shadow:0 18px 34px -22px var(--sky)}
.hero{position:relative;overflow:hidden}
.hero::before,.hero::after{content:"";position:absolute;border-radius:50%;background:var(--sky);opacity:.14;filter:blur(8px);animation:drift 14s ease-in-out infinite;pointer-events:none}
.hero::before{width:260px;height:260px;top:-80px;inset-inline-start:-60px}
.hero::after{width:180px;height:180px;bottom:-50px;inset-inline-end:8%;animation-delay:-6s}
@keyframes drift{50%{transform:translate(30px,24px) scale(1.12)}}
.hero .wrap{position:relative;z-index:1}
.card-word{animation:float 5s ease-in-out infinite}
@keyframes float{50%{translate:0 -10px}}
.rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s ease}
.rv.in{opacity:1;transform:none}
header.sc{box-shadow:0 8px 24px -16px rgba(0,0,0,.5)}
.by{margin-top:8px;font-size:14px;color:var(--muted)}.by b{color:var(--sky-d)}
.pg{position:fixed;top:env(safe-area-inset-top,0px);inset-inline-start:0;width:100%;height:3px;z-index:11;background:var(--sky);transform:scaleX(0);transform-origin:right center;pointer-events:none}
.w{display:inline-block;opacity:0;transform:translateY(18px);animation:wi .6s cubic-bezier(.2,.8,.2,1) forwards}
@keyframes wi{to{opacity:1;transform:none}}
nav a{position:relative}
nav a::after{content:"";position:absolute;inset-inline:0;bottom:-4px;height:2px;background:var(--sky);transform:scaleX(0);transition:transform .25s}
nav a:hover::after,nav a.on::after{transform:scaleX(1)}
nav a.on{color:var(--sky-d)}
.mark{transition:transform .25s}.logo:hover .mark{transform:rotate(-8deg) scale(1.08)}
.btn{position:relative;overflow:hidden}
.btn:not(.ghost):not(:disabled)::after{content:"";position:absolute;inset-block:0;width:40%;inset-inline-start:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.45),transparent);transform:skewX(-20deg);transition:inset-inline-start .6s;pointer-events:none}
.btn:not(.ghost):hover::after{inset-inline-start:120%}
.rp{position:absolute;border-radius:50%;background:currentColor;opacity:.28;transform:scale(0);animation:rp .6s ease-out forwards;pointer-events:none}
@keyframes rp{to{transform:scale(1);opacity:0}}
.card-word{transition:transform .15s ease-out,box-shadow .3s;will-change:transform}
.up{position:fixed;inset-block-end:calc(18px + env(safe-area-inset-bottom,0px));inset-inline-end:18px;z-index:9;width:46px;height:46px;border-radius:50%;border:0;background:var(--sky);color:var(--on-sky);font-size:20px;font-weight:800;box-shadow:0 10px 24px -10px var(--sky);opacity:0;transform:translateY(16px);pointer-events:none;transition:opacity .3s,transform .3s}
.up.on{opacity:1;transform:none;pointer-events:auto}
.in-app .up,.in-app .pg{display:none}
dialog[open]{animation:dg .3s ease}
@keyframes dg{from{opacity:0;transform:translateY(16px) scale(.97)}}
dialog[open]::backdrop{animation:fd .3s ease}
@keyframes fd{from{opacity:0}}
.soc a{transition:transform .2s,background .2s,color .2s}.soc a:hover{transform:translateY(-3px);background:var(--sky);color:var(--on-sky)}
.card-word{position:relative}
.card-word::after{content:"";position:absolute;inset:0;border-radius:inherit;border:2px solid var(--sky);opacity:0;pointer-events:none}
.card-word.ring::after{animation:ringo .6s ease-out}
@keyframes ringo{from{opacity:.75;transform:scale(1)}to{opacity:0;transform:scale(1.09)}}
.reveal .word{animation:flip .55s cubic-bezier(.2,.8,.2,1)}
.reveal .mean{animation:pop .55s .08s ease-out both}
@keyframes flip{from{opacity:0;transform:perspective(420px) rotateX(-80deg)}to{opacity:1;transform:none}}
.sp{position:absolute;width:9px;height:9px;border-radius:50%;background:var(--sky);pointer-events:none;z-index:2;animation:spk .7s ease-out forwards}
.sp:nth-child(3n){background:var(--sky-d);width:6px;height:6px}
@keyframes spk{from{opacity:1;transform:translate(0,0) scale(1)}to{opacity:0;transform:translate(var(--dx),var(--dy)) scale(.2)}}
footer .soc a{background:var(--bc,var(--sky));color:#fff}
footer .soc a[aria-label="واتساب"]{--bc:#25D366}
footer .soc a[aria-label="يوتيوب"]{--bc:#FF0000}
footer .soc a[aria-label="تيك توك"]{--bc:#000;box-shadow:inset 0 0 0 1.5px rgba(255,255,255,.28),2px 2px 0 #25f4ee,-2px -2px 0 #fe2c55}
footer .soc a[aria-label="فيسبوك"]{--bc:#1877F2}
footer .soc a:hover{background:var(--bc);color:#fff;transform:translateY(-4px) scale(1.08);filter:brightness(1.1)}
@media(prefers-reduced-motion:reduce){*{animation:none!important;scroll-behavior:auto!important}}
</style>
</head>
<body>
<header><div class="wrap bar">
  <a class="logo" href="#top"><span class="mark">E</span>منصة الأفندي</a>
  <nav><a href="#about">من نحن</a><a href="#teacher">المدرس</a><a href="#courses">المحاضرات</a><a href="#grades">السنوات الدراسية</a></nav>
  <button class="icon" id="theme" aria-label="تبديل الوضع الليلي والنهاري">◐</button>
  <button class="btn" data-open="register">سجل معنا الآن</button>
</div></header>

<main id="top">
<div class="hero" id="about"><div class="wrap">
  <div>
    <span class="tag">من نحن</span>
    <h1>منصة محمد مصطفى الأفندي التعليمية</h1>
    <p>تعلّم الإنجليزي بدون تعقيد: شرح بالفيديو، امتحانات بتتصحح فوراً، ومتابعة لولي الأمر. للإعدادي والثانوي والأزهر، أونلاين أو في السنتر.</p>
    <div class="cta"><button class="btn" data-open="register">ابدأ معنا</button><a class="btn ghost" href="#courses">تصفح المحاضرات</a></div>
    <div class="nums"><div><b>+10</b><span>سنين خبرة</span></div><div><b>+1500</b><span>طالب</span></div><div><b>9</b><span>صفوف دراسية</span></div></div>
  </div>
  <div class="card-word" id="card">
    <small>كلمة النهارده • اضغط على الكارت لتغييرها</small>
    <div class="word" id="en">Achieve</div>
    <div class="mean" id="ar">يحقق</div>
    <button class="btn ghost" id="next">كلمة تانية</button>
  </div>
</div></div>

<section id="teacher"><div class="wrap">
  <div class="head"><span class="tag">المدرس</span><h2>مدرسك المتميز</h2><p>خبرة أكتر من 10 سنين في تدريس الإنجليزي للإعدادي والثانوي.</p></div>
  <div class="panel teacher">
    <div class="avatar">م</div>
    <div><h3>أ/ محمد مصطفى الأفندي</h3><p>معلم اللغة الإنجليزية</p><button class="btn" data-open="login">عرض الملف</button></div>
  </div>
</div></section>

<section id="courses" style="background:var(--surface)"><div class="wrap">
  <div class="head"><span class="tag">المحاضرات</span><h2>اختار طريقة المذاكرة</h2><p>محاضرات فردية أو مجموعات كاملة بتغطي الترم.</p></div>
  <div class="grid">
    <div class="panel item"><h3>المجموعات التعليمية (الترمات)</h3><p>باقة كاملة بمحاضرات متسلسلة، تتفعل مرة واحدة بكود شحن أو دفع إلكتروني.</p><button class="btn" data-open="register">اشترك في مجموعة</button></div>
    <div class="panel item"><h3>المحاضرات المنفصلة</h3><p>فعّل المحاضرة اللي محتاجها بس، وشوفها لحد 5 مرات.</p><button class="btn ghost" data-open="register">تصفح المحاضرات</button></div>
    <div class="panel item"><h3>الامتحانات والشهادات</h3><p>بنك أسئلة كبير، تصحيح تلقائي، وشهادة تقدير لكل امتحان بتتفوق فيه.</p><button class="btn ghost" data-open="login">ادخل للامتحانات</button></div>
  </div>
</div></section>

<section id="grades"><div class="wrap">
  <div class="head"><span class="tag">المراحل الدراسية</span><h2>السنوات الدراسية</h2><p>اختار سنتك الدراسية وابدأ رحلتك.</p></div>
  <div class="grid" id="gl"></div>
</div></section>

<section style="background:var(--surface)"><div class="wrap why">
  <div>
    <span class="tag">لماذا نحن</span>
    <h2 style="margin-bottom:18px;font-size:clamp(24px,4.5vw,34px)">ليه تختار منصة الأفندي</h2>
    <ul>
      <li class="panel">شرح مبسط بالفيديو لكل وحدة دراسية</li>
      <li class="panel">اختبارات بتصحيح فوري وشهادات تقدير</li>
      <li class="panel">واجبات بتتصحح ودرجتها بتوصلك على المنصة</li>
      <li class="panel">تقارير الحضور والدرجات لولي الأمر</li>
    </ul>
  </div>
  <div class="panel join"><h2>ابدأ رحلتك التعليمية معانا</h2><p>سجّل دلوقتي وابدأ مذاكرة الإنجليزي من غير تعقيد.</p><button class="btn" data-open="register">سجل الآن</button></div>
</div></section>

</main>

<footer><div class="wrap">
  <div class="logo" style="justify-content:center"><span class="mark">E</span>منصة الأفندي</div>
  <div class="soc">
    <a href="https://wa.me/201117037976" target="_blank" rel="noopener" aria-label="واتساب"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2z"/><path d="M16.5 14.2c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.8 1c-.1.2-.3.2-.5.1-1.3-.6-2.3-1.3-3.1-2.8-.2-.3.2-.3.6-1 .1-.2 0-.3 0-.4l-.7-1.7c-.2-.4-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.6.6-.9 1.3-.9 2.1.1 1 .5 2 1.2 2.9 1.3 1.8 3 3 5 3.5.8.2 1.5.2 2.1-.1.6-.3 1.1-.9 1.2-1.5.1-.3.1-.6 0-.7-.1-.1-.2-.1-.4-.2z"/></svg></a>
    <a href="https://www.youtube.com/@Elafendlish" target="_blank" rel="noopener" aria-label="يوتيوب"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8zM10 15V9l5.2 3L10 15z"/></svg></a>
