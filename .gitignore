<div id="app"></div>
<dialog id="dlg"><div class="dlg">
  <button class="icon x" id="close" aria-label="إغلاق">✕</button>
  <h2 id="dt">أهلاً بيك</h2>
  <div class="tabs" role="tablist">
    <button role="tab" data-tab="login">دخول</button><button role="tab" data-tab="register">حساب جديد</button><button role="tab" data-tab="parent">ولي الأمر</button>
  </div>
  <div class="pane" id="p-login">
    <label for="e1">البريد الإلكتروني</label><input id="e1" type="email" autocomplete="email">
    <label for="pw1">كلمة المرور</label><input id="pw1" type="password" autocomplete="current-password">
    <button class="btn full" data-go="دخول المنصة">دخول المنصة</button>
    <p class="hint">تجربة المعلم: teacher@elafendi.com وكلمة المرور 123456</p>
  </div>
  <div class="pane" id="p-register">
    <label for="n2">الاسم بالكامل (رباعي)</label><input id="n2" autocomplete="name">
    <label for="e2">البريد الإلكتروني</label><input id="e2" type="email">
    <label for="g2">الصف الدراسي</label>
    <select id="g2"></select>
    <label for="pw2">كلمة المرور (6 أحرف على الأقل)</label><input id="pw2" type="password" autocomplete="new-password">
    <button class="btn full" data-go="إنشاء الحساب">إنشاء الحساب</button>
  </div>
  <div class="pane" id="p-parent">
    <label for="ph">هاتف ولي الأمر</label><input id="ph" type="tel" inputmode="tel">
    <label for="cd">كود الطالب (CE- أو ON-)</label><input id="cd" dir="ltr">
    <button class="btn full" data-go="دخول لوحة المتابعة">دخول لوحة المتابعة</button>
  </div>
  <div class="msg" id="msg" role="status"></div>
</div></dialog>

