raw:نيء`;
  var words=raw.split('\n').map(function(l){var k=l.indexOf(':');return [l.slice(0,k).trim(),l.slice(k+1).trim()]});
  var en=document.getElementById('en'),ar=document.getElementById('ar'),card=document.getElementById('card'),bag=[],cur=-1;
  function show(n){cur=n;card.classList.remove('reveal');void card.offsetWidth;en.textContent=words[n][0];ar.textContent=words[n][1];card.classList.add('reveal')}
  function nextW(){
    if(!bag.length){bag=words.map(function(_,k){return k});for(var k=bag.length-1;k>0;k--){var j=Math.floor(Math.random()*(k+1)),t=bag[k];bag[k]=bag[j];bag[j]=t}}
    var n=bag.pop();if(n===cur&&bag.length){bag.unshift(n);n=bag.pop()}show(n);
  }
  card.setAttribute('role','button');card.tabIndex=0;card.style.cursor='pointer';
  card.setAttribute('aria-label','كلمة جديدة: اضغط لتغيير الكلمة');
  card.addEventListener('click',nextW);
  card.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();nextW()}});
  var d0=Math.floor(Date.now()/864e5)%words.length;show(d0);card.classList.remove('reveal');
  var d=document.getElementById('dlg'),msg=document.getElementById('msg');
  var titles={login:'سجّل دخولك',register:'ابدأ رحلتك',parent:'متابعة ولي الأمر'};
  function tab(k){
    document.querySelectorAll('.pane').forEach(function(p){p.classList.toggle('on',p.id==='p-'+k)});
    document.querySelectorAll('[data-tab]').forEach(function(b){b.setAttribute('aria-selected',b.dataset.tab===k)});
    document.getElementById('dt').textContent=titles[k];msg.textContent='';
  }
  document.addEventListener('click',function(e){
    var o=e.target.closest('[data-open]');if(o){tab(o.dataset.open);d.showModal();return}
    var t=e.target.closest('[data-tab]');if(t){tab(t.dataset.tab);return}
    var g=e.target.closest('[data-go]');if(g){
      if(g.dataset.demo){tab('login');d.showModal();msg.textContent='تثبيت التطبيق هيشتغل في النسخة الفعلية.';return}
      window.__go(g.dataset.go);
    }
  });
  document.getElementById('close').onclick=function(){d.close()};
})();
</script>
<script>
(function(){
var K='ea1',S,G=['الصف الأول الإعدادي','الصف الثاني الإعدادي','الصف الثالث الإعدادي','الصف الأول (بكالوريا)','الصف الثاني (بكالوريا)','الصف الثالث الثانوي (عام)','الصف الأول الثانوي (أزهر)','الصف الثاني الثانوي (أزهر)','الصف الثالث الثانوي (أزهر)'];
try{S=JSON.parse(localStorage.getItem(K))}catch(e){}
if(!S)S={users:[{id:'t',role:'teacher',name:'مستر محمد مصطفى',email:'teacher@elafendi.com',pw:'123456'}],lectures:[],exams:[],results:[],session:null};
function save(){try{localStorage.setItem(K,JSON.stringify(S))}catch(e){}}
function esc(s){return String(s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
function $(i){return document.getElementById(i)}
function v(i){return $(i).value}
function uid(){return Date.now().toString(36)+Math.random().toString(36).slice(2,6)}
function me(){return S.users.find(function(u){return u.id===S.session})}
function opts(){return G.map(function(g){return '<option>'+g+'</option>'}).join('')}
var app=$('app'),cur='';
function start(u){S.session=u.id;save();$('dlg').close();document.body.classList.add('in-app');window.scrollTo(0,0);shell()}
window.__go=function(a){
  var m=$('msg');
  if(a==='دخول المنصة'){
    var e=v('e1').trim().toLowerCase(),p=v('pw1'),u=S.users.find(function(x){return x.email===e&&x.pw===p});
    if(!u){m.textContent='البريد الإلكتروني أو كلمة المرور غير صحيحة.';return}start(u);
  }else if(a==='إنشاء الحساب'){
    var n=v('n2').trim(),em=v('e2').trim().toLowerCase(),g=v('g2'),pw=v('pw2');
    if(n.length<3){m.textContent='اكتب اسمك بالكامل.';return}
    if(em.indexOf('@')<1){m.textContent='اكتب بريد إلكتروني صحيح.';return}
    if(G.indexOf(g)<0){m.textContent='اختر صفك الدراسي.';return}
    if(pw.length<6){m.textContent='كلمة المرور لازم تكون 6 أحرف على الأقل.';return}
    if(S.users.some(function(x){return x.email===em})){m.textContent='البريد ده مسجّل قبل كده. ادخل من تبويب «دخول».';return}
    var u2={id:uid(),role:'student',name:n,email:em,pw:pw,grade:g,code:'ON-'+Math.floor(10000+Math.random()*90000),xp:0,views:{},act:{}};
    S.users.push(u2);start(u2);
  }else m.textContent='«'+a+'» مش متاح في النسخة التجريبية.';
};
function shell(){
  var u=me();if(!u)return;
  var T=u.role==='teacher'?[['stu','الطلاب'],['nl','محاضرة جديدة'],['ne','امتحان جديد'],['res','الدرجات'],['mng','إدارة المحتوى']]:[['lec','المحاضرات'],['exm','الامتحانات'],['top','لوحة الشرف']];
  app.innerHTML='<div class="ab"><div class="wrap"><div class="who">'+esc(u.name)+'<small>'+(u.role==='teacher'?'لوحة المعلم':esc(u.grade)+' • كود '+esc(u.code)+' • '+u.xp+' XP')+'</small></div><button class="icon" id="th2" aria-label="تبديل الوضع">◐</button><button class="btn ghost" id="lo">خروج</button></div></div><div class="wrap"><div class="tb" id="tb" role="tablist">'+T.map(function(t){return '<button role="tab" data-t="'+t[0]+'">'+t[1]+'</button>'}).join('')+'</div><div id="v"></div></div>';
  tab(T[0][0]);
}
function tab(k){
  cur=k;var u=me(),h='';
  Array.prototype.forEach.call(document.querySelectorAll('#tb button'),function(b){b.setAttribute('aria-selected',b.dataset.t===k)});
  if(k==='lec'){
    var L=S.lectures.filter(function(l){return l.grade===u.grade});
    h=L.length?L.map(function(l){
      var vw=u.views[l.id]||0,free=!l.price||u.act[l.id];
      return '<div class="panel row"><div><h3>'+esc(l.title)+'</h3><small>'+(l.price?esc(l.price)+' ج.م':'مجانية')+'</small></div><div class="acts">'+
        (free?(vw>=5?'<button class="btn ghost" disabled>خلصت المشاهدات</button>':'<button class="btn" data-w="'+l.id+'">شاهد ('+vw+'/5)</button>'):
        '<input data-c="'+l.id+'" placeholder="كود التفعيل" aria-label="كود التفعيل"><button class="btn ghost" data-a="'+l.id+'">تفعيل</button>')+'</div></div>'}).join(''):'<div class="empty">مفيش محاضرات لصفك لسه. هتظهر هنا أول ما المستر يضيفها.</div>';
    h+='<div class="st" id="st" role="status"></div>';
  }else if(k==='exm'){
    var E=S.exams.filter(function(e){return e.grade===u.grade});
    h=E.length?E.map(function(e){
      var r=S.results.find(function(x){return x.uid===u.id&&x.eid===e.id});
      return '<div class="panel row"><div><h3>'+esc(e.title)+'</h3><small>'+e.qs.length+' سؤال'+(r?' • أعلى نتيجة '+r.pct+'%':'')+'</small></div><button class="btn" data-x="'+e.id+'">'+(r?'أعد الامتحان':'ابدأ الامتحان')+'</button></div>'}).join(''):'<div class="empty">مفيش امتحانات لصفك لسه.</div>';
  }else if(k==='top'){
    var R=S.users.filter(function(x){return x.role==='student'}).sort(function(a,b){return b.xp-a.xp}).slice(0,10);
    h=R.length?'<div class="panel tbl"><table><tr><th>#</th><th>الطالب</th><th>الصف</th><th>XP</th></tr>'+R.map(function(x,i){return '<tr><td>'+(i+1)+'</td><td>'+esc(x.name)+'</td><td>'+esc(x.grade)+'</td><td>'+x.xp+'</td></tr>'}).join('')+'</table></div>':'<div class="empty">لوحة الشرف فاضية لسه.</div>';
  }else if(k==='stu'){
    var A=S.users.filter(function(x){return x.role==='student'});
    h=A.length?'<div class="panel tbl"><table><tr><th>الطالب</th><th>الصف</th><th>الكود</th><th>البريد</th><th>XP</th></tr>'+A.map(function(x){return '<tr><td>'+esc(x.name)+'</td><td>'+esc(x.grade)+'</td><td>'+esc(x.code)+'</td><td>'+esc(x.email)+'</td><td>'+x.xp+'</td></tr>'}).join('')+'</table></div>':'<div class="empty">مفيش طلاب مسجلين لسه.</div>';
  }else if(k==='nl'){
    h='<div class="panel form"><h3>إضافة محاضرة</h3><label for="lg">الصف</label><select id="lg">'+opts()+'</select><label for="lt">عنوان المحاضرة</label><input id="lt"><label for="lp">السعر بالجنيه (0 = مجانية)</label><input id="lp" type="number" min="0" value="0"><label for="lu">رابط الفيديو (يوتيوب)</label><input id="lu" dir="ltr" placeholder="https://"><label for="lc">كود التفعيل (للمحاضرات المدفوعة)</label><input id="lc" dir="ltr"><button class="btn full" id="sl">حفظ ونشر</button><div class="st" id="st" role="status"></div></div>';
  }else if(k==='ne'){
    h='<div class="panel form"><h3>إضافة امتحان</h3><label for="eg">الصف</label><select id="eg">'+opts()+'</select><label for="et">اسم الامتحان</label><input id="et"><label for="eq">الأسئلة، سؤال في كل سطر بالشكل ده:</label><p class="hint" dir="ltr" style="text-align:left">Question | A | B | C | D | 2</p><textarea id="eq" dir="ltr"></textarea><p class="hint">الرقم الأخير (1 إلى 4) هو رقم الإجابة الصحيحة.</p><button class="btn full" id="se">حفظ ونشر الامتحان</button><div class="st" id="st" role="status"></div></div>';
  }else if(k==='res'){
    h=S.results.length?'<div class="panel tbl"><table><tr><th>الطالب</th><th>الامتحان</th><th>النسبة</th><th>التاريخ</th></tr>'+S.results.map(function(r){
      var s=S.users.find(function(x){return x.id===r.uid}),e=S.exams.find(function(x){return x.id===r.eid});
      return '<tr><td>'+esc(s?s.name:'—')+'</td><td>'+esc(e?e.title:'—')+'</td><td>'+r.pct+'%</td><td>'+esc(r.date)+'</td></tr>'}).join('')+'</table></div>':'<div class="empty">مفيش نتائج لسه.</div>';
  }else if(k==='mng'){
    h='<h3 style="margin:6px 0 12px">المحاضرات</h3>'+(S.lectures.length?S.lectures.map(function(l){return '<div class="panel row"><div><h3>'+esc(l.title)+'</h3><small>'+esc(l.grade)+'</small></div><button class="btn ghost" data-dl="'+l.id+'">حذف</button></div>'}).join(''):'<div class="empty">لا توجد محاضرات.</div>')+
      '<h3 style="margin:22px 0 12px">الامتحانات</h3>'+(S.exams.length?S.exams.map(function(e){return '<div class="panel row"><div><h3>'+esc(e.title)+'</h3><small>'+esc(e.grade)+'</small></div><button class="btn ghost" data-de="'+e.id+'">حذف</button></div>'}).join(''):'<div class="empty">لا توجد امتحانات.</div>');
  }
  $('v').innerHTML=h;
}
function say(t,ok){var s=$('st');if(s){s.textContent=t;s.className='st '+(ok?'ok':'bad')}}
function exam(id){
  var e=S.exams.find(function(x){return x.id===id});if(!e)return;
  $('v').innerHTML='<h3 style="margin:6px 0 14px">'+esc(e.title)+'</h3>'+e.qs.map(function(q,i){
    return '<div class="panel q"><b dir="ltr" style="display:block;text-align:left">'+(i+1)+'. '+esc(q.q)+'</b>'+q.o.map(function(o,j){return '<label dir="ltr" style="justify-content:flex-start"><input type="radio" name="q'+i+'" value="'+j+'">'+esc(o)+'</label>'}).join('')+'</div>'}).join('')+
    '<button class="btn full" data-sub="'+id+'">تسليم الامتحان</button><div class="st" id="st" role="status"></div>';
}
function submit(id){
  var u=me(),e=S.exams.find(function(x){return x.id===id}),ok=0,ans=[];
  e.qs.forEach(function(q,i){var c=document.querySelector('input[name="q'+i+'"]:checked');ans.push(c?+c.value:-1);if(c&&+c.value===q.a)ok++});
  if(ans.indexOf(-1)>=0){say('جاوب على كل الأسئلة قبل التسليم.',false);return}
  var pct=Math.round(ok/e.qs.length*100),pr=S.results.find(function(r){return r.uid===u.id&&r.eid===id});
  if(!pr){S.results.push({uid:u.id,eid:id,pct:pct,date:new Date().toLocaleDateString('ar-EG')});u.xp+=Math.round(pct/10)}
  else if(pct>pr.pct){u.xp+=Math.round((pct-pr.pct)/10);pr.pct=pct}
  save();shell();
  $('v').innerHTML='<div class="panel res">نتيجتك '+pct+'% ('+ok+' من '+e.qs.length+')</div>'+e.qs.map(function(q,i){
    return '<div class="panel q"><b dir="ltr" style="display:block;text-align:left">'+(i+1)+'. '+esc(q.q)+'</b><span class="'+(ans[i]===q.a?'ok':'bad')+'">'+(ans[i]===q.a?'إجابة صحيحة ✓':'إجابتك غلط. الصحيحة: ')+'</span>'+(ans[i]===q.a?'':'<span dir="ltr">'+esc(q.o[q.a])+'</span>')+'</div>'}).join('');
  Array.prototype.forEach.call(document.querySelectorAll('#tb button'),function(b){b.setAttribute('aria-selected',b.dataset.t==='exm')});
}
app.addEventListener('click',function(ev){
  var t=ev.target.closest('button');if(!t)return;var u=me();
  if(t.id==='lo'){S.session=null;save();document.body.classList.remove('in-app');app.innerHTML='';return}
  if(t.id==='th2'){$('theme').click();return}
  if(t.dataset.t){tab(t.dataset.t);return}
  if(t.dataset.w){var l=S.lectures.find(function(x){return x.id===t.dataset.w});u.views[l.id]=(u.views[l.id]||0)+1;save();
    if(/^https?:\/\//.test(l.url))window.open(l.url,'_blank','noopener');tab('lec');return}
  if(t.dataset.a){var l2=S.lectures.find(function(x){return x.id===t.dataset.a}),i=app.querySelector('input[data-c="'+t.dataset.a+'"]');
    if(i&&l2.code&&i.value.trim()===l2.code){u.act[l2.id]=1;save();tab('lec')}else say('الكود غير صحيح. اطلبه من المستر أو من الدعم.',false);return}
  if(t.dataset.x){exam(t.dataset.x);return}
  if(t.dataset.sub){submit(t.dataset.sub);return}
  if(t.dataset.dl){S.lectures=S.lectures.filter(function(x){return x.id!==t.dataset.dl});save();tab('mng');return}
  if(t.dataset.de){S.exams=S.exams.filter(function(x){return x.id!==t.dataset.de});save();tab('mng');return}
  if(t.id==='sl'){
    var ti=v('lt').trim(),url=v('lu').trim(),pr=Math.max(0,+v('lp')||0),cd=v('lc').trim();
    if(!ti){say('اكتب عنوان المحاضرة.',false);return}
    if(!/^https?:\/\//.test(url)){say('الرابط لازم يبدأ بـ https://',false);return}
    if(pr>0&&!cd){say('اكتب كود تفعيل للمحاضرة المدفوعة.',false);return}
    S.lectures.push({id:uid(),grade:v('lg'),title:ti,price:pr,url:url,code:cd});save();tab('nl');say('تم نشر المحاضرة.',true);return}
  if(t.id==='se'){
    var et=v('et').trim(),qs=[],bad=0;
    v('eq').split('\n').forEach(function(ln){if(!ln.trim())return;var p=ln.split('|').map(function(x){return x.trim()}),a=+p[5];
      if(p.length!==6||!(a>=1&&a<=4)||p.slice(0,5).some(function(x){return !x})){bad++;return}
      qs.push({q:p[0],o:p.slice(1,5),a:a-1})});
    if(!et){say('اكتب اسم الامتحان.',false);return}
    if(bad||!qs.length){say(bad?'فيه '+bad+' سطر بصيغة غلط. راجع الشكل المطلوب.':'اكتب سؤال واحد على الأقل.',false);return}
    S.exams.push({id:uid(),grade:v('eg'),title:et,qs:qs});save();tab('ne');say('تم نشر الامتحان ('+qs.length+' سؤال).',true)}
});
})();
</script>
<script>
(function(){
  var hd=document.querySelector('header');
  addEventListener('scroll',function(){hd.classList.toggle('sc',scrollY>8)},{passive:true});
  if(matchMedia('(prefers-reduced-motion: reduce)').matches||!('IntersectionObserver' in window))return;
  var els=document.querySelectorAll('section .wrap > *:not(.grid), section .grid > *');
  var io=new IntersectionObserver(function(es){es.forEach(function(e){
    if(!e.isIntersecting)return;io.unobserve(e.target);e.target.classList.add('in');(function(t){setTimeout(function(){t.classList.remove('rv','in');t.style.transitionDelay=''},1400)})(e.target);
    if(e.target.classList.contains('nums'))count(e.target);
  })},{threshold:.15});
  els.forEach(function(el){el.classList.add('rv');if(el.parentNode.classList.contains('grid'))el.style.transitionDelay=(Array.prototype.indexOf.call(el.parentNode.children,el)%4)*90+'ms';io.observe(el)});
  document.querySelectorAll('.hero .nums').forEach(count);
  function count(box){
    box.querySelectorAll('b').forEach(function(b){
      var t=b.textContent,n=parseInt(t.replace(/\D/g,''),10),p=t.charAt(0)==='+'?'+':'',st=performance.now();
      function f(now){var k=Math.min(1,(now-st)/1100);b.textContent=p+Math.round(n*(1-Math.pow(1-k,3)));if(k<1)requestAnimationFrame(f)}
      requestAnimationFrame(f);
    });
  }
})();
</script>
<script>
(function(){
  var rm=matchMedia('(prefers-reduced-motion: reduce)').matches;
  var pg=document.createElement('div');pg.className='pg';document.body.appendChild(pg);
  var up=document.createElement('button');up.className='up';up.textContent='↑';up.setAttribute('aria-label','للأعلى');document.body.appendChild(up);
  up.onclick=function(){scrollTo({top:0,behavior:rm?'auto':'smooth'})};
  function sc(){var h=document.documentElement,m=h.scrollHeight-innerHeight;pg.style.transform='scaleX('+(m>0?scrollY/m:0)+')';up.classList.toggle('on',scrollY>500)}
  addEventListener('scroll',sc,{passive:true});sc();
  var links=document.querySelectorAll('nav a');
  if('IntersectionObserver' in window){
    var so=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){links.forEach(function(a){a.classList.toggle('on',a.getAttribute('href')==='#'+e.target.id)})}})},{rootMargin:'-45% 0px -50% 0px'});
    ['about','teacher','courses','grades'].forEach(function(i){var el=document.getElementById(i);if(el)so.observe(el)});
  }
  document.addEventListener('click',function(e){
    var b=e.target.closest('.btn');if(!b||b.disabled||rm)return;
    var r=b.getBoundingClientRect(),s=Math.max(r.width,r.height)*2,x=document.createElement('span');
    x.className='rp';x.style.cssText='width:'+s+'px;height:'+s+'px;left:'+(e.clientX-r.left-s/2)+'px;top:'+(e.clientY-r.top-s/2)+'px';
    b.appendChild(x);setTimeout(function(){x.remove()},650);
  });
  if(rm)return;
  var h1=document.querySelector('.hero h1');
  if(h1){var t=h1.textContent.trim().split(/\s+/);h1.setAttribute('aria-label',t.join(' '));
    h1.innerHTML=t.map(function(w,i){return '<span class="w" aria-hidden="true" style="animation-delay:'+(i*90+100)+'ms">'+w+'</span>'}).join(' ')}
  var c=document.getElementById('card');
  if(c&&matchMedia('(hover:hover)').matches){
    c.addEventListener('pointermove',function(e){var r=c.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;
      c.style.transform='perspective(700px) rotateY('+(x*14)+'deg) rotateX('+(-y*14)+'deg)'});
    c.addEventListener('pointerleave',function(){c.style.transform=''});
  }
})();
</script>
<script>
(function(){
  var c=document.getElementById('card');if(!c||matchMedia('(prefers-reduced-motion: reduce)').matches)return;
  c.addEventListener('click',function(e){
    var r=c.getBoundingClientRect(),x=e.clientX?e.clientX-r.left:r.width/2,y=e.clientY?e.clientY-r.top:r.height/2;
    c.classList.remove('ring');void c.offsetWidth;c.classList.add('ring');
    for(var i=0;i<12;i++){
      var s=document.createElement('span'),a=Math.PI*2*i/12+Math.random()*.4,d=50+Math.random()*40;
      s.className='sp';s.style.cssText='left:'+(x-4)+'px;top:'+(y-4)+'px;--dx:'+Math.cos(a)*d+'px;--dy:'+Math.sin(a)*d+'px';
      c.appendChild(s);(function(n){setTimeout(function(){n.remove()},750)})(s);
    }
  });
})();
</script>
</body>
</html>
